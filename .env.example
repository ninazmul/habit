# ============================================================
# Habit by Rizmec — Environment Variable TEMPLATE
# ============================================================
# Copy to `.env.local` and fill in real values.
# ============================================================

# Site URL
NEXT_PUBLIC_SITE_URL=https://habit.rizmec.com

# ------------------------------------------------------------
# Clerk Authentication  (REQUIRED)
# ------------------------------------------------------------
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Clerk Auth Paths
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/

# ------------------------------------------------------------
# MongoDB  (REQUIRED)
# ------------------------------------------------------------
MONGODB_URI=

# ------------------------------------------------------------
# Vault Master Encryption Secret  (REQUIRED for Vault)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ------------------------------------------------------------
VAULT_SECRET_KEY=

# ------------------------------------------------------------
# Google Gemini AI Key  (OPTIONAL - for AI commands & analysis)
# ------------------------------------------------------------
GEMINI_API_KEY=

# ------------------------------------------------------------
# Email Notifications  (OPTIONAL)
# Resend or SMTP settings
# ------------------------------------------------------------
EMAIL_PROVIDER=resend
RESEND_API_KEY=
NOTIFICATION_EMAIL=

# For SMTP fallback:
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# ------------------------------------------------------------
# Cron Job Security Secret
# ------------------------------------------------------------
CRON_SECRET=
