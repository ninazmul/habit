# ============================================================
# Habit by Rizmec — Environment Variable TEMPLATE
# ============================================================
# Copy to `.env.local` and fill in real values.
# ============================================================

# ------------------------------------------------------------
# Clerk Authentication  (REQUIRED)
# https://clerk.com → Create an application → Get API keys
# ------------------------------------------------------------
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Clerk Auth Paths
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/

# Clerk Encryption Key (for session tokens)
CLERK_ENCRYPTION_KEY=

# ------------------------------------------------------------
# MongoDB  (REQUIRED)
# https://cloud.mongodb.com → Create cluster → Get connection string
# ------------------------------------------------------------
MONGODB_URI=

# ------------------------------------------------------------
# Google Gemini AI  (OPTIONAL — for AI-powered analysis)
# https://aistudio.google.com → Get API key
# ------------------------------------------------------------
GEMINI_API_KEY=

# ------------------------------------------------------------
# Email Notifications — Gmail SMTP  (OPTIONAL)
# Requires Gmail App Password (not regular password)
# https://myaccount.google.com → Security → 2FA → App Passwords
# ------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your-sender@gmail.com
SMTP_PASSWORD=your-gmail-app-password
NOTIFICATION_EMAIL=your-receiver@gmail.com

# ------------------------------------------------------------
# Google AdSense  (OPTIONAL)
# ------------------------------------------------------------
NEXT_PUBLIC_ADSENSE_CLIENT_ID=
NEXT_PUBLIC_ADSENSE_SLOT_ID=
